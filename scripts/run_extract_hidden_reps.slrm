#!/bin/bash
#SBATCH --job-name=boltz_hidden_reps
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=32GB
#SBATCH --time=02:00:00
#SBATCH --output=%x.%j.out

# ===========================================================================
# Extract hidden representations from Boltz2 Pairformer
#
# Usage (single test):
#   sbatch run_extract_hidden_reps.slrm /path/to/input.yaml /path/to/output_dir
#
# Usage (directory of sequences):
#   sbatch run_extract_hidden_reps.slrm /path/to/yaml_dir /path/to/output_dir
#
# Optional environment variables (override defaults via --export):
#   BOLTZ_CACHE          — default: /n/holylfs06/LABS/kempner_shared/Everyone/workflow/boltz/boltz_db
#   BOLTZ_ENV_PATH       — default: /n/holylfs06/LABS/kempner_shared/Everyone/common_envs/miniconda3/envs/boltz
#   RECYCLING_STEPS      — default: 3
#   SAMPLING_STEPS       — default: 200
#   DIFFUSION_SAMPLES    — default: 1
#   LAYERS               — comma-separated layer indices or "all" (default: all)
#   SITES                — comma-separated top-level sites or "all" (default: all)
#   LAYER_SITES          — comma-separated per-layer sites or "all" (default: all)
#   RECYCLING_STEP_SAVE  — which recycling step to save: -1=last, -2=all (default: -1)
#   EXTRACT_REPO         — path to protein_interpretability repo
# ===========================================================================

set -euo pipefail

# ---- Arguments ----
INPUT_DATA="${1:?Usage: sbatch run_extract_hidden_reps.slrm INPUT_DATA OUTPUT_DIR}"
OUTPUT_DIR="${2:?Usage: sbatch run_extract_hidden_reps.slrm INPUT_DATA OUTPUT_DIR}"

# ---- Defaults ----
BOLTZ_CACHE="${BOLTZ_CACHE:-/n/holylfs06/LABS/kempner_shared/Everyone/workflow/boltz/boltz_db}"
BOLTZ_ENV_PATH="${BOLTZ_ENV_PATH:-/n/holylfs06/LABS/kempner_shared/Everyone/common_envs/miniconda3/envs/boltz}"
RECYCLING_STEPS="${RECYCLING_STEPS:-3}"
SAMPLING_STEPS="${SAMPLING_STEPS:-200}"
DIFFUSION_SAMPLES="${DIFFUSION_SAMPLES:-1}"
LAYERS="${LAYERS:-all}"
SITES="${SITES:-all}"
LAYER_SITES="${LAYER_SITES:-all}"
RECYCLING_STEP_SAVE="${RECYCLING_STEP_SAVE:--1}"
EXTRACT_REPO="${EXTRACT_REPO:-$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")}"

# ---- Environment setup ----
module load python/3.12.8-fasrc01 gcc/14.2.0-fasrc01 cuda/12.9.1-fasrc01 cudnn/9.10.2.21_cuda12-fasrc01
mamba activate "$BOLTZ_ENV_PATH"

export CUDA_VISIBLE_DEVICES=0
export CUEQ_DEFAULT_CONFIG="${CUEQ_DEFAULT_CONFIG:-1}"
export CUEQ_DISABLE_AOT_TUNING="${CUEQ_DISABLE_AOT_TUNING:-1}"

# Set per-job Triton cache
JOB_ID="${SLURM_JOB_ID:-manual}"
export TRITON_CACHE_DIR="${SLURM_TMPDIR:-/tmp}/triton_cache_${USER}_${JOB_ID}"
mkdir -p "$TRITON_CACHE_DIR"

# ---- Paths ----
INPUT_DATA="$(realpath "$INPUT_DATA")"
OUTPUT_DIR="$(realpath -m "$OUTPUT_DIR")"
mkdir -p "$OUTPUT_DIR"

echo "==============================================="
echo "Boltz2 Hidden Representation Extraction"
echo "==============================================="
echo "  Input:            $INPUT_DATA"
echo "  Output:           $OUTPUT_DIR"
echo "  Cache:            $BOLTZ_CACHE"
echo "  Repo:             $EXTRACT_REPO"
echo "  Recycling steps:  $RECYCLING_STEPS"
echo "  Sampling steps:   $SAMPLING_STEPS"
echo "  Diffusion samples:$DIFFUSION_SAMPLES"
echo "  Layers:           $LAYERS"
echo "  Sites:            $SITES"
echo "  Layer sites:      $LAYER_SITES"
echo "  Save step:        $RECYCLING_STEP_SAVE"
echo "==============================================="

# ---- Run extraction ----
PYTHONPATH="${EXTRACT_REPO}/src:${PYTHONPATH:-}" \
python -m protein_interpretability.extract_hidden_reps \
    "$INPUT_DATA" \
    --out_dir "$OUTPUT_DIR" \
    --cache "$BOLTZ_CACHE" \
    --accelerator gpu \
    --recycling_steps "$RECYCLING_STEPS" \
    --sampling_steps "$SAMPLING_STEPS" \
    --diffusion_samples "$DIFFUSION_SAMPLES" \
    --layers "$LAYERS" \
    --sites "$SITES" \
    --layer_sites "$LAYER_SITES" \
    --recycling_step "$RECYCLING_STEP_SAVE"

echo ""
echo "==============================================="
echo "[$(date +%H:%M:%S)] Done. Output in: $OUTPUT_DIR"

# Report file sizes
echo ""
echo "Output sizes:"
du -sh "$OUTPUT_DIR"/* 2>/dev/null || true
echo ""
find "$OUTPUT_DIR" -name "metadata.json" -exec echo "--- {} ---" \; -exec cat {} \; 2>/dev/null || true
echo "==============================================="
