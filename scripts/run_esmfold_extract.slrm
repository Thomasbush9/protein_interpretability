#!/bin/bash
#SBATCH --job-name=esmfold_extract
#SBATCH --nodes=1
#SBATCH --partition=kempner_h100
#SBATCH --account=kempner_bsabatini_lab
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=2
#SBATCH --mem=128GB
#SBATCH --time=12:00:00
#SBATCH --output=/n/home06/tbush/job_logs/%x.%A_%a.out

# ===========================================================================
# ESMFold hidden-representation extraction (orchestrator version)
#
# Wraps scripts/run_esmfold_extract.py so it runs non-interactively under
# SLURM. All extraction parameters (input/output dirs, sites, layers,
# num_recycles, num_gpus) are read from the YAML config — edit the
# config, not this script.
#
# Usage:
#   sbatch scripts/run_esmfold_extract.slrm                              # default config
#   sbatch scripts/run_esmfold_extract.slrm /abs/path/my_config.yaml     # custom config
#
# IMPORTANT: keep --gpus-per-node in sync with runtime.num_gpus in the
# config — the orchestrator launches one subprocess per GPU.
# ===========================================================================

set -euo pipefail

# ---- Paths ----
REPO_ROOT="/n/holylfs06/LABS/bsabatini_lab/Everyone/tbush/protein_interpretability"
CONFIG_PATH="${1:-$REPO_ROOT/scripts/esmfold_extract_config.yaml}"

if [[ ! -f "$CONFIG_PATH" ]]; then
    echo "ERROR: config not found: $CONFIG_PATH" >&2
    exit 1
fi

# ---- Environment ----
# ESMFold uses a different conda env than Boltz.  Adjust the path or create
# a prepare_env_esmfold.sh if your cluster layout differs.  The env needs:
#   transformers, torch, pyyaml, sentencepiece
module load python

# mamba/conda init may not be sourced in batch shells — activate explicitly.
#eval "$(conda shell.bash hook)"
mamba activate /n/holylfs06/LABS/bsabatini_lab/Everyone/protforge/envs/esmfold


#export PYTHONPATH="$REPO_ROOT/src:${PYTHONPATH:-}"

JOB_ID="${SLURM_JOB_ID:-manual}"
#export TRITON_CACHE_DIR="${SLURM_TMPDIR:-/tmp}/triton_cache_${USER}_${JOB_ID}"
#mkdir -p "$TRITON_CACHE_DIR"

echo "==============================================="
echo "ESMFold Hidden Rep Extraction (orchestrator)"
echo "==============================================="
echo "  Repo:       $REPO_ROOT"
echo "  Config:     $CONFIG_PATH"
echo "  GPUs:       ${SLURM_GPUS_ON_NODE:-?}"
echo "==============================================="

python "$REPO_ROOT/scripts/run_esmfold_extract.py" --config "$CONFIG_PATH"

echo ""
echo "[$(date +%H:%M:%S)] Done."
